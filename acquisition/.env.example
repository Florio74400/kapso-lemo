# Copier ce fichier en ".env" (en local) ou saisir ces variables dans l'hébergeur.
# Ne jamais commiter de vraies valeurs. Ne jamais les coller dans une conversation.

# --- Application ---
PORT=3000
# URL publique HTTPS de l'app (ex: https://lemo-mini.up.railway.app). Sert aux liens et au webhook.
PUBLIC_URL=http://localhost:3000
# Secret interne (cookies, empreinte des numéros). Générer : openssl rand -hex 32
APP_SECRET=
# true = simulateur dans le navigateur, aucun message WhatsApp réel
DEMO_MODE=false
# Garde-fou phase de test : LEMO ne répond qu'à ces numéros (format 33612345678, séparés par des virgules)
ALLOWED_TEST_NUMBERS=

# --- Base de données (Supabase > Connect > Session pooler). Vide = base locale embarquée ---
DATABASE_URL=

# --- Kapso ---
KAPSO_API_KEY=
# Sandbox Kapso : 597907523413541 / numéro 56920403095. Remplacer par votre numéro une fois connecté.
KAPSO_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_NUMBER=
# Secret choisi à la création du webhook dans Kapso (sert à vérifier la signature)
KAPSO_WEBHOOK_SECRET=

# --- Claude (console.anthropic.com > API keys). Vide = analyse simulée ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
